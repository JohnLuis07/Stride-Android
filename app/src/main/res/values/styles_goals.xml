<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StrideGoalLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/goals_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StrideGoalField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_goals_field</item>
        <item name="android:textColor">@color/goals_ink</item>
        <item name="android:textColorHint">@color/goals_muted</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="StrideGoalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_goals_chip</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/goals_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StrideGoalPrimary" parent="StrideGoalButton">
        <item name="android:background">@drawable/bg_goals_primary</item>
        <item name="android:textColor">@color/goals_surface</item>
    </style>
    <style name="StrideGoalStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="StrideGoalStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/goals_ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StrideGoalStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/goals_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
