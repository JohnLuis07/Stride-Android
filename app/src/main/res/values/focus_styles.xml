<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StrideFocusButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_focus_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="StrideFocusMode" parent="StrideFocusButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/focus_muted</item>
        <item name="android:background">@drawable/bg_focus_mode</item>
    </style>
    <style name="StrideFocusTechnique">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_focus_technique</item>
        <item name="android:buttonTint">@color/focus_pomodoro</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/focus_ink</item>
    </style>
</resources>
