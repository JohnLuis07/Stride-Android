<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StrideAuthCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_auth_card</item>
        <item name="android:elevation">3dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="StrideAuthTitle" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textSize">29sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="StrideAuthSubtitle" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/auth_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="StrideAuthLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/auth_label</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StrideAuthInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_auth_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textColorHint">@color/auth_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="StrideAuthPrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:background">@drawable/bg_auth_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="StrideAuthSecondaryButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_auth_secondary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/auth_accent</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
