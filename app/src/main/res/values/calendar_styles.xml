<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StrideCalendarTextButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:background">@drawable/bg_workspace_nav</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/workspace_accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="StrideCalendarPrimaryButton" parent="StrideCalendarTextButton">
        <item name="android:background">@drawable/bg_calendar_primary_button</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="StrideCalendarWeekday" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/workspace_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="StrideCalendarLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/workspace_ink</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StrideCalendarField" parent="@android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_calendar_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/workspace_ink</item>
        <item name="android:textColorHint">@color/workspace_secondary</item>
    </style>

    <style name="StrideCalendarPickerButton" parent="StrideCalendarTextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_calendar_field</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/workspace_ink</item>
    </style>
</resources>
