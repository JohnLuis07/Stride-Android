<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:focusableInTouchMode="true"
    tools:context="com.stride.android.ui.LoginScreen"
    tools:theme="@style/Theme.Stride">

    <ImageView
        android:layout_width="172dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_auth_header"
        android:clipToOutline="true"
        android:contentDescription="@string/stride_logo"
        android:scaleType="centerCrop"
        android:src="@drawable/stride_logo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:text="@string/auth_tagline"
        android:textColor="@color/auth_muted"
        android:textSize="13sp" />

    <LinearLayout style="@style/StrideAuthCard">

        <TextView
            style="@style/StrideAuthTitle"
            android:accessibilityHeading="true"
            android:text="@string/auth_login_title" />

        <TextView
            style="@style/StrideAuthSubtitle"
            android:text="@string/auth_login_subtitle" />

        <TextView
            android:id="@+id/email_label"
            style="@style/StrideAuthLabel"
            android:layout_marginTop="20dp"
            android:labelFor="@id/email_input"
            android:text="@string/auth_email_label" />

        <EditText
            android:id="@+id/email_input"
            style="@style/StrideAuthInput"
            android:autofillHints="emailAddress"
            android:hint="@string/auth_email_hint"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:nextFocusForward="@id/password_input"
            android:nextFocusDown="@id/password_input"
            tools:text="you@example.com" />

        <TextView
            android:id="@+id/password_label"
            style="@style/StrideAuthLabel"
            android:labelFor="@id/password_input"
            android:text="@string/auth_password_label" />

        <EditText
            android:id="@+id/password_input"
            style="@style/StrideAuthInput"
            android:autofillHints="password"
            android:hint="@string/auth_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            tools:text="password123" />

        <Button
            android:id="@+id/sign_in_button"
            style="@style/StrideAuthPrimaryButton"
            android:text="@string/auth_sign_in" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_new_here"
                android:textColor="@color/auth_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/create_account_button"
                style="@style/StrideAuthSecondaryButton"
                android:layout_marginStart="2dp"
                android:text="@string/auth_create_account" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/auth_footer"
        android:textColor="@color/auth_muted"
        android:textSize="12sp" />
</LinearLayout>
