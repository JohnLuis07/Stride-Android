<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/notes_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/close_button"
            style="@style/StrideNotesTextButton"
            android:text="@string/note_ai_close" />
        <TextView
            android:id="@+id/study_title"
            android:layout_height="wrap_content"
            android:textColor="@color/notes_ink"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/feedback_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="@color/notes_muted"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/notes_accent"
                android:paddingBottom="12dp" />
            <TextView
                android:id="@+id/study_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/notes_ink"
                android:textSize="18sp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="5dp" />
            <Button
                android:id="@+id/reveal_button"
                style="@style/StrideNotesTextButton"
                android:text="@string/note_ai_reveal" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/options_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/notes_ink"
                android:textSize="14sp"
                android:paddingTop="16dp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="4dp" />
            <TextView
                android:id="@+id/score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/notes_ink"
                android:textSize="14sp"
                android:paddingTop="12dp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/no_citations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/note_ai_no_citations"
                android:textSize="12sp"
                android:textColor="@color/notes_muted"
                android:paddingTop="16dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/citations_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/previous_button"
            style="@style/StrideNotesTextButton"
            android:text="@string/note_ai_previous"
            android:layout_width="0dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/next_button"
            style="@style/StrideNotesTextButton"
            android:text="@string/note_ai_next"
            android:layout_width="0dp"
            android:layout_weight="1" />
    </LinearLayout>
    <Button
        android:id="@+id/save_button"
        style="@style/StrideNotesTextButton"
        android:text="@string/note_ai_save"
        android:layout_width="match_parent"
        android:layout_margin="12dp" />
</LinearLayout>