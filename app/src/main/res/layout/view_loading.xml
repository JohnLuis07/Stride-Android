<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stride_surface">

    <ScrollView
        android:id="@+id/loading_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clickable="true"
        android:focusable="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/stride_logo" />

            <TextView
                android:id="@+id/loading_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/workspace_loading_title"
                android:textColor="@color/stride_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/loading_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/workspace_loading_message"
                android:textColor="@color/stride_muted"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/loading_spinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="24dp"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/stride_primary" />

            <Button
                android:id="@+id/loading_retry"
                style="@style/StrideTaskChip"
                android:layout_marginTop="24dp"
                android:text="@string/workspace_loading_retry"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
