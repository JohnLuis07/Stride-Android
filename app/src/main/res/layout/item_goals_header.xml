<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/goals_title"
        android:textColor="@color/goals_ink"
        android:textSize="30sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/goals_subtitle"
        android:textColor="@color/goals_muted"
        android:textSize="15sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_goals_card"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goals_overview"
            android:letterSpacing="0.12"
            android:textColor="@color/goals_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                style="@style/StrideGoalStat">
                <TextView
                    android:id="@+id/total_count"
                    style="@style/StrideGoalStatValue" />
                <TextView
                    style="@style/StrideGoalStatLabel"
                    android:text="@string/goals_total" />
            </LinearLayout>
            <LinearLayout
                style="@style/StrideGoalStat">
                <TextView
                    android:id="@+id/active_count"
                    style="@style/StrideGoalStatValue" />
                <TextView
                    style="@style/StrideGoalStatLabel"
                    android:text="@string/goals_active" />
            </LinearLayout>
            <LinearLayout
                style="@style/StrideGoalStat">
                <TextView
                    android:id="@+id/completed_count"
                    style="@style/StrideGoalStatValue"
                    android:textColor="@color/goals_success" />
                <TextView
                    style="@style/StrideGoalStatLabel"
                    android:text="@string/goals_completed" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goals_average"
                android:textColor="@color/goals_muted"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/momentum_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/goals_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/momentum_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_goals_progress" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/add_button"
            style="@style/StrideGoalPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/goals_new" />
        <Button
            android:id="@+id/refresh_button"
            style="@style/StrideGoalButton"
            android:layout_marginStart="10dp"
            android:text="@string/goals_refresh" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/goals_section"
        android:textColor="@color/goals_ink"
        android:textSize="20sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/filter_all"
                style="@style/StrideGoalButton"
                android:text="@string/goals_all" />
            <Button
                android:id="@+id/filter_active"
                style="@style/StrideGoalButton"
                android:layout_marginStart="8dp"
                android:text="@string/goals_active" />
            <Button
                android:id="@+id/filter_completed"
                style="@style/StrideGoalButton"
                android:layout_marginStart="8dp"
                android:text="@string/goals_completed" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/goals_muted"
        android:textSize="12sp" />
    <ProgressBar
        android:id="@+id/loading_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/goals_accent"
        android:visibility="gone" />
    <TextView
        android:id="@+id/feedback_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/goals_muted"
        android:textSize="14sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_goals_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_workspace_goals"
            android:tint="@color/goals_accent"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/goals_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/goals_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>