<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:id="@+id/content_container"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="18dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Profile &amp; settings"
			android:textColor="@color/stride_text"
			android:textSize="27sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/profile_email"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="@color/stride_muted"
			android:textSize="16sp" />

		<Button
			android:id="@+id/edit_button"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="16dp"
			android:background="@drawable/bg_primary_button"
			android:text="Edit profile"
			android:textColor="@android:color/white" />

		<LinearLayout
			android:id="@+id/profile_editor"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:background="@drawable/bg_card"
			android:orientation="vertical"
			android:padding="16dp"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Edit profile"
				android:textColor="@color/stride_text"
				android:textSize="19sp"
				android:textStyle="bold" />

			<EditText
				android:id="@+id/profile_name_input"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:hint="Full name" />

			<EditText
				android:id="@+id/profile_email_input"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="Email"
				android:inputType="textEmailAddress" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<Button
					android:id="@+id/cancel_profile_button"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_weight="1"
					android:background="@drawable/bg_secondary_button"
					android:text="Cancel"
					android:textColor="@color/stride_primary" />

				<Button
					android:id="@+id/save_profile_button"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_primary_button"
					android:text="Save"
					android:textColor="@android:color/white" />
			</LinearLayout>
		</LinearLayout>

		<Button
			android:id="@+id/features_button"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_secondary_button"
			android:text="Choose dashboard features"
			android:textColor="@color/stride_primary" />

		<LinearLayout
			android:id="@+id/features_editor"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:background="@drawable/bg_card"
			android:orientation="vertical"
			android:padding="16dp"
			android:visibility="gone">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Dashboard features"
				android:textColor="@color/stride_text"
				android:textSize="19sp"
				android:textStyle="bold" />

			<CheckBox
				android:id="@+id/feature_notes_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:text="Notes" />

			<CheckBox
				android:id="@+id/feature_calendar_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Calendar" />

			<CheckBox
				android:id="@+id/feature_tasks_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Todo" />

			<CheckBox
				android:id="@+id/feature_goals_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Goals" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<Button
					android:id="@+id/cancel_features_button"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_weight="1"
					android:background="@drawable/bg_secondary_button"
					android:text="Cancel"
					android:textColor="@color/stride_primary" />

				<Button
					android:id="@+id/save_features_button"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_marginStart="8dp"
					android:layout_weight="1"
					android:background="@drawable/bg_primary_button"
					android:text="Save"
					android:textColor="@android:color/white" />
			</LinearLayout>
		</LinearLayout>

		<Button
			android:id="@+id/logout_button"
			android:layout_width="match_parent"
			android:layout_height="52dp"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_secondary_button"
			android:text="Logout"
			android:textColor="#B8374B" />
	</LinearLayout>
</ScrollView>
