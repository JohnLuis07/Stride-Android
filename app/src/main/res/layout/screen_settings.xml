<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workspace_surface"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView style="@style/StrideSettingsLabel" android:text="@string/settings_eyebrow" />
        <TextView
            style="@style/StrideSettingsHeading"
            android:layout_marginTop="6dp"
            android:text="@string/settings_title"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            style="@style/StrideSettingsBody"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_workspace_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/StrideSettingsLabel" android:text="@string/settings_profile_label" />
            <TextView
                android:id="@+id/profile_initials"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_workspace_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/workspace_accent"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="AL" />
            <TextView
                android:id="@+id/profile_name"
                style="@style/StrideSettingsHeading"
                android:layout_marginTop="14dp"
                android:textSize="24sp"
                tools:text="Alex Lawson" />
            <TextView
                android:id="@+id/profile_email"
                style="@style/StrideSettingsBody"
                android:layout_marginTop="4dp"
                android:textIsSelectable="true"
                tools:text="alex@stride.app" />
            <Button
                android:id="@+id/edit_button"
                style="@style/StrideSettingsSecondaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/settings_edit" />

            <LinearLayout
                android:id="@+id/profile_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/StrideSettingsHeading" android:text="@string/settings_edit" />
                <TextView
                    style="@style/StrideSettingsBody"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_profile_hint" />
                <TextView
                    style="@style/StrideSettingsBody"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/profile_name_input"
                    android:text="@string/settings_name" />
                <EditText
                    android:id="@+id/profile_name_input"
                    style="@style/StrideSettingsInput"
                    android:layout_marginTop="6dp"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
                <TextView
                    style="@style/StrideSettingsBody"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/profile_email_input"
                    android:text="@string/settings_email" />
                <EditText
                    android:id="@+id/profile_email_input"
                    style="@style/StrideSettingsInput"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress" />
                <ProgressBar
                    android:id="@+id/profile_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/settings_saving"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/save_profile_button"
                    style="@style/StrideSettingsButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_save_profile" />
                <Button
                    android:id="@+id/cancel_profile_button"
                    style="@style/StrideSettingsSecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_cancel" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_workspace_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/StrideSettingsLabel" android:text="@string/settings_features_label" />
            <TextView
                style="@style/StrideSettingsHeading"
                android:layout_marginTop="12dp"
                android:text="@string/settings_features_title" />
            <TextView
                style="@style/StrideSettingsBody"
                android:layout_marginTop="6dp"
                android:text="@string/settings_features_hint" />
            <TextView
                android:id="@+id/feature_summary"
                style="@style/StrideSettingsBody"
                android:layout_marginTop="12dp"
                android:textColor="@color/workspace_accent"
                android:accessibilityLiveRegion="polite" />
            <Button
                android:id="@+id/features_button"
                style="@style/StrideSettingsSecondaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/settings_customize" />
            <LinearLayout
                android:id="@+id/features_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/features_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_settings_feature" />
                <ProgressBar
                    android:id="@+id/features_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/settings_saving"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/save_features_button"
                    style="@style/StrideSettingsButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_save_features" />
                <Button
                    android:id="@+id/cancel_features_button"
                    style="@style/StrideSettingsSecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_cancel" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_workspace_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/StrideSettingsLabel" android:text="@string/settings_account" />
            <TextView
                style="@style/StrideSettingsBody"
                android:layout_marginTop="12dp"
                android:text="@string/settings_sign_out_hint" />
            <Button
                android:id="@+id/logout_button"
                style="@style/StrideSettingsSecondaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/settings_sign_out"
                android:textColor="@color/workspace_logout" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
