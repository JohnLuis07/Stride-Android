<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen"
    android:fillViewport="true"
    tools:context="com.stride.android.SignupScreen"
    tools:theme="@style/Theme.Stride">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="24dp"
        android:paddingRight="22dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="26dp"
            android:paddingRight="24dp"
            android:paddingBottom="26dp">

            <ImageView
                android:layout_width="164dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/stride_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/stride_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Create your account"
                android:textColor="@color/stride_text"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="A little progress, every day. Start with Stride."
                android:textColor="@color/stride_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:autofillHints="name"
                android:background="@drawable/bg_auth_input"
                android:hint="Full name"
                android:inputType="textPersonName|textCapWords"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/stride_text"
                android:textColorHint="@color/stride_muted"
                android:textSize="15sp"
                tools:text="Alex Rivera" />

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_auth_input"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/stride_text"
                android:textColorHint="@color/stride_muted"
                android:textSize="15sp"
                tools:text="alex@stride.app" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_auth_input"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/stride_text"
                android:textColorHint="@color/stride_muted"
                android:textSize="15sp"
                tools:text="password123" />

            <EditText
                android:id="@+id/confirm_password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:autofillHints="newPassword"
                android:background="@drawable/bg_auth_input"
                android:hint="Confirm password"
                android:inputType="textPassword"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:singleLine="true"
                android:textColor="@color/stride_text"
                android:textColorHint="@color/stride_muted"
                android:textSize="15sp"
                tools:text="password123" />

            <Button
                android:id="@+id/create_account_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_auth_primary_button"
                android:text="Create account"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/back_to_sign_in_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_auth_secondary_button"
                android:text="I already have an account"
                android:textAllCaps="false"
                android:textColor="@color/stride_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
