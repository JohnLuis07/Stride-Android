<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/StrideCalendarLabel"
            android:labelFor="@id/event_title_input"
            android:text="@string/calendar_title_label" />

        <EditText
            android:id="@+id/event_title_input"
            style="@style/StrideCalendarField"
            android:hint="@string/calendar_title_hint"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            style="@style/StrideCalendarLabel"
            android:labelFor="@id/event_details_input"
            android:text="@string/calendar_details_label" />

        <EditText
            android:id="@+id/event_details_input"
            style="@style/StrideCalendarField"
            android:gravity="top|start"
            android:hint="@string/calendar_details_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="5" />

        <TextView
            style="@style/StrideCalendarLabel"
            android:labelFor="@id/event_date_button"
            android:text="@string/calendar_date_label" />

        <Button
            android:id="@+id/event_date_button"
            style="@style/StrideCalendarPickerButton"
            android:drawableEnd="@drawable/ic_workspace_calendar"
            android:drawableTint="@color/workspace_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    style="@style/StrideCalendarLabel"
                    android:labelFor="@id/event_start_button"
                    android:text="@string/calendar_start_label" />

                <Button
                    android:id="@+id/event_start_button"
                    style="@style/StrideCalendarPickerButton"
                    android:text="@string/calendar_optional_time" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    style="@style/StrideCalendarLabel"
                    android:labelFor="@id/event_end_button"
                    android:text="@string/calendar_end_label" />

                <Button
                    android:id="@+id/event_end_button"
                    style="@style/StrideCalendarPickerButton"
                    android:text="@string/calendar_optional_time" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/clear_times_button"
            style="@style/StrideCalendarTextButton"
            android:layout_gravity="end"
            android:text="@string/calendar_clear_times" />

        <TextView
            style="@style/StrideCalendarLabel"
            android:labelFor="@id/event_category_spinner"
            android:text="@string/calendar_category_label" />

        <Spinner
            android:id="@+id/event_category_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/calendar_error"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
