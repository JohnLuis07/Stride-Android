<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_notes_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">
    <TextView
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/notes_ink"
        android:textSize="14sp"
        android:background="@drawable/bg_notes_field"
        android:padding="12dp"
        android:textStyle="bold"
        android:textIsSelectable="true" />
    <TextView
        android:id="@+id/answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/notes_ink"
        android:textSize="14sp"
        android:paddingTop="12dp"
        android:lineSpacingExtra="5dp"
        android:textIsSelectable="true" />
    <TextView
        android:id="@+id/no_citations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/note_ai_no_citations"
        android:paddingTop="8dp"
        android:textSize="11sp"
        android:textColor="@color/notes_muted" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/citations_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />
</LinearLayout>