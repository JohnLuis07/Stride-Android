match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/cancel_goal_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_secondary_button" android:text="Cancel"/><Button android:id="@+id/save_goal_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_primary_button" android:text="Save goal" android:textColor="@android:color/white"/></LinearLayout></LinearLayout><TextView android:id="@+id/empty_goals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="No goals yet. Add your first goal." android:textColor="@color/stride_muted"/><LinearLayout android:id="@+id/list_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical"/></LinearLayout></ScrollView>
