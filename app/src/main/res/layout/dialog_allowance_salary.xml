<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/AllowanceBody" android:text="@string/allowance_salary_hint" android:layout_marginBottom="16dp" />
        <TextView android:id="@+id/amount_label" style="@style/AllowanceBody" android:labelFor="@id/amount_input" />
        <EditText android:id="@+id/amount_input" style="@style/AllowanceInput" android:inputType="numberDecimal" android:maxLength="16" android:singleLine="true" />
        <TextView style="@style/AllowanceBody" android:text="@string/allowance_salary_date" android:labelFor="@id/date_button" />
        <Button android:id="@+id/date_button" style="@style/AllowanceButton" />
        <TextView style="@style/AllowanceBody" android:text="@string/allowance_note" android:labelFor="@id/note_input" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/note_input" style="@style/AllowanceInput" android:inputType="textMultiLine|textCapSentences" android:maxLength="280" android:minLines="2" android:gravity="top" />
        <TextView android:id="@+id/error" style="@style/AllowanceBody" android:textColor="@color/allowance_expense" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
