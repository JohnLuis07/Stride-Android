<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:background="@color/workspace_surface">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:id="@+id/summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                <TextView style="@style/AllowanceHeading" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/allowance_overview" android:textSize="22sp" />
                <ImageButton android:id="@+id/settings" style="@style/StrideWorkspaceIconButton"
                    android:src="@drawable/ic_workspace_settings" android:tint="@color/allowance_accent"
                    android:contentDescription="@string/allowance_settings" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_allowance_header">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/AllowanceBody" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/allowance_eyebrow" android:textColor="#D7EEE4"
                        android:letterSpacing="0.1" android:textSize="11sp" />
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_workspace_allowance" android:tint="#D7EEE4" android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView android:id="@+id/daily_amount" style="@style/AllowanceHeading"
                    android:textSize="36sp" android:textColor="#FFFFFF" android:layout_marginTop="12dp"
                    android:text="@string/allowance_unavailable" />
                <TextView android:id="@+id/payday_detail" style="@style/AllowanceBody"
                    android:textColor="#E4F4EC" android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_allowance_card">
                    <TextView style="@style/AllowanceBody" android:text="@string/allowance_income" />
                    <TextView android:id="@+id/income_total" style="@style/AllowanceHeading"
                        android:textColor="@color/allowance_accent" android:textSize="20sp" android:layout_marginTop="8dp" android:accessibilityHeading="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:padding="16dp" android:layout_marginStart="12dp" android:background="@drawable/bg_allowance_card">
                    <TextView style="@style/AllowanceBody" android:text="@string/allowance_expense" />
                    <TextView android:id="@+id/expense_total" style="@style/AllowanceHeading"
                        android:textColor="@color/allowance_expense" android:textSize="20sp" android:layout_marginTop="8dp" android:accessibilityHeading="false" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="20dp" android:layout_marginTop="14dp" android:background="@drawable/bg_allowance_card">
                <TextView style="@style/AllowanceBody" android:text="@string/allowance_balance" />
                <TextView android:id="@+id/balance_amount" style="@style/AllowanceHeading"
                    android:textSize="26sp" android:layout_marginTop="4dp" android:accessibilityHeading="false" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/allowance_border" android:layout_marginTop="16dp" android:layout_marginBottom="14dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/AllowanceBody" android:text="@string/allowance_reserved" android:textSize="12sp" />
                        <TextView android:id="@+id/reserved_amount" style="@style/AllowanceHeading"
                            android:textSize="16sp" android:layout_marginTop="6dp" android:accessibilityHeading="false" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView style="@style/AllowanceBody" android:text="@string/allowance_spendable" android:textSize="12sp" />
                        <TextView android:id="@+id/spendable_amount" style="@style/AllowanceHeading"
                            android:textSize="18sp" android:layout_marginTop="6dp" android:accessibilityHeading="false" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/deficit" style="@style/AllowanceBody" android:text="@string/allowance_deficit"
                    android:textColor="@color/allowance_expense" android:layout_marginTop="12dp" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="18dp" android:baselineAligned="false">
                <Button android:id="@+id/add_income" style="@style/AllowancePrimaryButton"
                    android:layout_width="0dp" android:layout_weight="1" android:text="@string/allowance_add_income" />
                <Button android:id="@+id/add_expense" style="@style/AllowancePrimaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/allowance_add_expense" />
            </LinearLayout>
            <TextView android:id="@+id/setup_hint" style="@style/AllowanceBody" android:text="@string/allowance_setup_inline"
                android:textColor="@color/allowance_accent" android:layout_marginTop="10dp" android:visibility="gone" />
            <Button android:id="@+id/declare_salary" style="@style/AllowanceButton" android:text="@string/allowance_declare_salary" android:layout_marginTop="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="20dp" android:layout_marginTop="14dp" android:background="@drawable/bg_allowance_card">
                <TextView style="@style/AllowanceHeading" android:text="@string/allowance_forecast" />
                <Button android:id="@+id/forecast_date" style="@style/AllowanceButton" android:layout_marginTop="8dp" />
                <TextView style="@style/AllowanceBody" android:text="@string/allowance_forecast_balance" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/forecast_balance" style="@style/AllowanceHeading" android:textSize="26sp" android:accessibilityHeading="false" />
                <TextView android:id="@+id/forecast_income" style="@style/AllowanceBody" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/forecast_expenses" style="@style/AllowanceBody" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/forecast_spendable" style="@style/AllowanceBody" android:layout_marginTop="4dp" />
                <TextView style="@style/AllowanceBody" android:text="@string/allowance_forecast_hint" android:textSize="12sp" android:layout_marginTop="12dp" />
            </LinearLayout>
            <TextView style="@style/AllowanceBody" android:text="@string/allowance_manual_hint"
                android:textSize="12sp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
            <TextView android:id="@+id/error" style="@style/AllowanceBody" android:textColor="@color/allowance_expense"
                android:accessibilityLiveRegion="polite" android:visibility="gone" android:layout_marginBottom="10dp" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
                android:indeterminateTint="@color/allowance_accent" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                <TextView style="@style/AllowanceHeading" android:layout_width="0dp" android:layout_weight="1" android:text="@string/allowance_history" />
                <Button android:id="@+id/refresh" style="@style/AllowanceTextButton" android:text="@string/allowance_refresh" />
            </LinearLayout>
            <TextView android:id="@+id/history_count" style="@style/AllowanceBody" android:layout_marginBottom="12dp" />
            <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/bg_allowance_card">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_workspace_allowance" android:importantForAccessibility="no" />
                <TextView style="@style/AllowanceHeading" android:text="@string/allowance_empty_title"
                    android:textSize="16sp" android:gravity="center" android:layout_marginTop="12dp" />
                <TextView style="@style/AllowanceBody" android:text="@string/allowance_empty"
                    android:gravity="center" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/entries_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" android:overScrollMode="never" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
