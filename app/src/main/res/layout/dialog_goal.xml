<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">
        <TextView
            style="@style/StrideGoalLabel"
            android:labelFor="@id/title_input"
            android:text="@string/goals_title_label" />
        <EditText
            android:id="@+id/title_input"
            style="@style/StrideGoalField"
            android:hint="@string/goals_title_hint"
            android:inputType="textCapSentences"
            android:singleLine="true" />
        <TextView
            style="@style/StrideGoalLabel"
            android:labelFor="@id/notes_input"
            android:text="@string/goals_notes_label" />
        <EditText
            android:id="@+id/notes_input"
            style="@style/StrideGoalField"
            android:gravity="top|start"
            android:hint="@string/goals_notes_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:maxLines="6" />
        <TextView
            style="@style/StrideGoalLabel"
            android:labelFor="@id/target_input"
            android:text="@string/goals_target_label" />
        <EditText
            android:id="@+id/target_input"
            style="@style/StrideGoalField"
            android:inputType="numberDecimal"
            android:singleLine="true" />
        <TextView
            android:id="@+id/unit_label"
            style="@style/StrideGoalField"
            android:gravity="center_vertical|start"
            android:text="%" />
        <TextView
            style="@style/StrideGoalLabel"
            android:labelFor="@id/date_button"
            android:text="@string/goals_date_label" />
        <Button
            android:id="@+id/date_button"
            style="@style/StrideGoalField"
            android:backgroundTint="@null"
            android:gravity="center_vertical|start"
            android:textAllCaps="false"
            android:text="@string/goals_no_date"
            android:drawableEnd="@drawable/ic_workspace_calendar"
            android:drawableTint="@color/goals_accent" />
        <Button
            android:id="@+id/clear_date_button"
            style="@style/StrideGoalButton"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/goals_clear_date" />
        <TextView
            style="@style/StrideGoalLabel"
            android:labelFor="@id/time_button"
            android:text="@string/goals_time_label" />
        <Button
            android:id="@+id/time_button"
            style="@style/StrideGoalField"
            android:backgroundTint="@null"
            android:gravity="center_vertical|start"
            android:textAllCaps="false"
            android:text="@string/goals_time_choose_date" />
        <Button
            android:id="@+id/clear_time_button"
            style="@style/StrideGoalButton"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/goals_clear_time" />
        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/goals_warning"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
