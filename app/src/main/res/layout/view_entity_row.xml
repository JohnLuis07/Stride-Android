<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/entity_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:id="@+id/entity_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/stride_text" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/entity_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/stride_muted" android:textSize="14sp" />
</LinearLayout>
