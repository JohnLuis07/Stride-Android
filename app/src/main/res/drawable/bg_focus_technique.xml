<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/focus_soft" />
            <stroke android:width="2dp" android:color="@color/focus_pomodoro" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/focus_surface" />
            <stroke android:width="1dp" android:color="@color/focus_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
